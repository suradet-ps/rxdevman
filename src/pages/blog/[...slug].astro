---
import { getCollection, render } from 'astro:content';

import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import { getEntrySlug } from '@/utils/slugify';

// Prerender one static page per post so blog content lands in the
// sitemap and the Pagefind index. The view counter is hydrated
// client-side in ViewCounter.astro.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: getEntrySlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPostLayout frontmatter={post.data} headings={headings} slug={getEntrySlug(post.id)}>
  <Content />
</BlogPostLayout>
