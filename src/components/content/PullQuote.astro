---
/**
 * PullQuote - Highlights key statements or memorable quotes
 * Editorial rules: gradient rule above, neutral rule below, centered text.
 * Deliberately not italic: Thai text reads better upright.
 */
---

<blockquote class="pull-quote">
  <slot />
</blockquote>

<style>
  .pull-quote {
    /* Layout */
    position: relative;
    max-width: 640px;
    margin: var(--space-12) auto;
    padding: var(--space-8) 0;
    text-align: center;

    /* Typography */
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.8;
    color: var(--text-heading);

    /* Reset prose blockquote defaults */
    background: transparent;
    border: none;
    border-radius: 0;
    font-style: normal;
  }

  /* Rule above - brand gradient */
  .pull-quote::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-red), var(--brand-orange));
  }

  /* Rule below - neutral */
  .pull-quote::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 3px;
    border-radius: 2px;
    background: var(--border-default);
  }

  /* Content cleanup */
  .pull-quote :global(p) {
    margin: 0;
  }

  .pull-quote :global(p + p) {
    margin-top: var(--space-4);
  }

  .pull-quote :global(strong) {
    color: var(--brand-red);
    font-weight: 600;
  }

  .pull-quote :global(em) {
    font-style: normal;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--brand-red) 45%, transparent);
    text-underline-offset: 4px;
  }

  .pull-quote :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--brand-red) 8%, transparent);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .pull-quote {
      padding: var(--space-6) 0;
      margin: var(--space-8) 0;
      font-size: 1.1rem;
    }
  }
</style>
