---
type Props = {
  slug: string;
  label?: string;
  labelBefore?: boolean;
};

const { slug, label = 'visitors', labelBefore = false } = Astro.props;
---

<span class="view-counter" data-slug={slug}>
  {labelBefore ? `${label} ` : null}<span class="view-count-value">0</span>{labelBefore
    ? null
    : ` ${label}`}
</span>

<script>
  const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
  const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  function displayCount(element: HTMLElement, count: number): void {
    const value = element.querySelector<HTMLElement>('.view-count-value');
    if (value)
      value.textContent = count.toLocaleString();
  }

  // Reads the aggregate with the public anon key (RLS allows anon SELECT
  // on rxdevman_view_counts). Skipped when the env vars are missing.
  async function loadCount(element: HTMLElement, slug: string): Promise<void> {
    if (!supabaseUrl || !supabaseAnonKey)
      return;

    try {
      const params = new URLSearchParams({
        select: 'unique_visitors',
        page_slug: `eq.${slug}`,
        limit: '1',
      });
      const response = await fetch(
        `${supabaseUrl}/rest/v1/rxdevman_view_counts?${params}`,
        {
          headers: {
            apikey: supabaseAnonKey,
            Authorization: `Bearer ${supabaseAnonKey}`,
          },
        },
      );
      if (!response.ok)
        return;

      const rows = (await response.json()) as Array<{ unique_visitors?: number }>;
      displayCount(element, rows[0]?.unique_visitors ?? 0);
    }
    catch {
      // Keep the static placeholder when the count cannot be fetched.
    }
  }

  async function trackVisit(slug: string): Promise<void> {
    try {
      await fetch('/api/track', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug }),
      });
    }
    catch {
      // Tracking is best effort.
    }
  }

  async function hydrateCounters(): Promise<void> {
    const counters = document.querySelectorAll<HTMLElement>('.view-counter');
    for (const element of counters) {
      const slug = element.dataset.slug;
      if (!slug)
        continue;
      await loadCount(element, slug);
      await trackVisit(slug);
    }
  }

  void hydrateCounters();
</script>

<style>
  .view-counter {
    font-family: var(--font-mono);
    font-size: 0.9em;
    opacity: 0.8;
  }
</style>
