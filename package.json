    "@size-limit/file": "^14.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "size-limit": "^14.0.0",
