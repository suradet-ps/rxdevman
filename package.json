    "brace-expansion": "^5.0.12",
    "browserslist": "^4.28.7",
    "devalue": "^5.9.1",
    "fast-uri": "^4.1.3",
    "http-cache-semantics": "^4.3.0",
    "js-yaml": "^4.3.2",
    "minimatch": "^10.2.3",
    "nanoid": "^6.0.0",
    "path-to-regexp": "^8.0.0",
    "postcss": "^8.5.18",
