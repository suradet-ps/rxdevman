{
  "name": "rxdev-man",
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && bun run pagefind",
    "pagefind": "bunx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "audit": "bun audit",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.4",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@supabase/supabase-js": "^2.111.0",
    "astro": "^7.1.6",
    "astro-auto-import": "^0.5.2",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "astro-pagefind": "^2.0.1",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@size-limit/preset-app": "^13.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "size-limit": "^13.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "fast-uri": "^4.0.0",
    "js-yaml": "^5.0.0",
    "minimatch": "^10.2.3",
    "path-to-regexp": "^8.0.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0",
    "svgo": "^4.0.2",
    "tar": "^7.5.19",
    "undici": "^8.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md,mdx,astro}": [
      "eslint --fix"
    ]
  },
  "size-limit": [
    {
      "path": "dist/client/_astro/*.js",
      "limit": "10 KB",
      "gzip": true
    }
  ]
}
