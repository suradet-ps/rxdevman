    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@supabase/supabase-js": "^2.111.0",
    "astro": "^7.3.2",
    "astro-auto-import": "^0.6.0",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "astro-pagefind": "^2.0.1",
    "typescript": "^6.0.3",
    "zod": "^4.6.2"
